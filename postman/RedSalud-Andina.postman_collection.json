          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Episodio clínico",
      "item": [
        {
          "name": "Abrir episodio por sincronización",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"eventId\": \"{{openEventId}}\",\n    \"aggregateId\": \"{{episodeId}}\",\n    \"sequence\": 0,\n    \"type\": \"EPISODE_OPENED\",\n    \"occurredAt\": \"{{openedAt}}\",\n    \"patientId\": \"{{patientId}}\"\n  }\n]"
            },
            "url": "{{baseUrl}}/api/sync/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Evento aplicado', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body[0].status).to.eql('APPLIED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reenviar el mismo evento es idempotente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"eventId\": \"{{openEventId}}\",\n    \"aggregateId\": \"{{episodeId}}\",\n    \"sequence\": 0,\n    \"type\": \"EPISODE_OPENED\",\n    \"occurredAt\": \"{{openedAt}}\",\n    \"patientId\": \"{{patientId}}\"\n  }\n]"
            },
            "url": "{{baseUrl}}/api/sync/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sigue aplicado sin duplicar', () => pm.expect(pm.response.json()[0].status).to.eql('APPLIED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leer episodio con motivo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Access-Reason",
                "value": "Atención de prueba Postman"
