{
  "info": {
    "_postman_id": "fa7e663b-e241-4a72-8a90-02dc4a760d86",
    "name": "RedSalud Andina - API",
    "description": "Pruebas ordenadas de RedSalud Andina: seguridad, episodios, agenda, interconsultas, recetas, legado, auditoría y analítica. Ver postman/README.md. JWT local: ejecutar scripts/postman-jwt.mjs --serve y usar perfiles dev,postman. Para Cognito usar el ambiente vacío con JWT reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ruralDoctorToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Reiniciar los datos de negocio al comenzar cada ejecución completa.",
          "if (pm.info.requestName === 'Health público responde UP') {",
          "  ['episodeId','openEventId','bookingId','consultId','prescriptionId','attachmentId','directBookingId','slotStart','slotEnd','slotId','directSlotId','openedAt'].forEach(k => pm.collectionVariables.unset(k));",
          "}",
          "const ids = ['patientId', 'episodeId', 'openEventId', 'bookingId', 'consultId', 'prescriptionId'];",
          "ids.forEach(name => {",
          "  if (!pm.collectionVariables.get(name)) {",
          "    pm.collectionVariables.set(name, pm.variables.replaceIn('{{$guid}}'));",
          "  }",
          "});",
          "if (!pm.collectionVariables.get('slotStart')) {",
          "  const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
          "  const end = new Date(start.getTime() + 60 * 60 * 1000);",
          "  pm.collectionVariables.set('slotStart', start.toISOString());",
          "  pm.collectionVariables.set('slotEnd', end.toISOString());",
          "}",
          "if (!pm.collectionVariables.get('openedAt')) pm.collectionVariables.set('openedAt', new Date().toISOString());",
          "if (!pm.collectionVariables.get('attachmentId')) pm.collectionVariables.set('attachmentId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.collectionVariables.get('directBookingId')) pm.collectionVariables.set('directBookingId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "episodeId",
      "value": ""
    },
    {
      "key": "openEventId",
      "value": ""
    },
    {
      "key": "slotId",
      "value": ""
    },
    {
      "key": "slotStart",
      "value": ""
    },
    {
      "key": "slotEnd",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "consultId",
      "value": ""
    },
    {
      "key": "prescriptionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Salud y seguridad",
      "item": [
        {
          "name": "Health público responde UP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "La sonda de salud no requiere autenticación."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Aplicación UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Endpoint protegido sin token devuelve 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/agenda/slots?specialty={{specialty}}",
            "description": "Comprueba que la API no acepte peticiones anónimas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rol incorrecto en analítica devuelve 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/analytics/centers",
